# The server is deliberately bound to this computer only.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=4310
WEB_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=info

# Local PostgreSQL container. Change both values together if you change the password.
POSTGRES_PASSWORD=personal_ai_dev
DATABASE_URL=postgresql://personal_ai:personal_ai_dev@127.0.0.1:5434/personal_ai

# Start with mock so the entire application works before any paid provider is connected.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_DEEP_MODEL=gpt-5.6
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local Ollama provider.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
# Optional smaller structured-output model; defaults to OLLAMA_CHAT_MODEL when empty.
OLLAMA_MEMORY_MODEL=
OLLAMA_THINK=false

# Dynamic context is selected by estimated tokens, not a fixed message count.
# Keep this below the provider's input window so static instructions and output have headroom.
CONTEXT_INPUT_TOKEN_BUDGET=12000
CONTEXT_HISTORY_PAGE_SIZE=50

# Highest approved-memory sensitivity automatically admitted to model context (0-3).
# Defaults to 1 for OpenAI and 3 for local Ollama/mock providers.
MEMORY_CONTEXT_MAX_SENSITIVITY=

# This owner-controlled file is read again for every reply, so edits apply without a restart.
PERSONALISATION_FILE=config/personalisation/profile.local.json

# Used later for signed local sessions and encrypted connector metadata.
# The bootstrap script replaces this with a random value in .env.
APP_SECRET=development-only-secret-change-me

# The UI is served by Vite in development. Set true when running the production build.
SERVE_UI=false
